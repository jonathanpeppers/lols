<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lols</RootNamespace>
    <ApplicationId>dev.slint.dotnet.lols</ApplicationId>
    <ApplicationTitle>LOLs per second</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <!-- The ABIs that Slint has libraries for. -->
    <RuntimeIdentifiers>android-arm64;android-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="yurkinh.slint.net" Version="1.19.0-preview.7" />
    <SlintFile Include="../ui/lols.slint" />
    <Compile Include="../LolsBenchmark.cs" />
  </ItemGroup>
</Project>
