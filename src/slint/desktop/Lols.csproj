<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Lols</RootNamespace>
  </PropertyGroup>
  <!-- Measure published Release builds, which are native code. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <PublishAot>true</PublishAot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="yurkinh.slint.net" Version="1.19.0-preview.7" />
    <SlintFile Include="../ui/lols.slint" />
    <Compile Include="../LolsBenchmark.cs" />
  </ItemGroup>
</Project>
